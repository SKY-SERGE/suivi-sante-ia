# ==============================================================================
# DOCKERFILE OPTIMISÉ POUR DÉVELOPPEMENT - SUIVI SANTÉ IA
# ==============================================================================
# Configuration optimisée pour le développement avec hot-reload rapide
# ==============================================================================

FROM node:18-alpine

# Install necessary dependencies with security updates
RUN apk update && apk upgrade && \
    apk add --no-cache \
    libc6-compat \
    ca-certificates \
    git \
    && rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /app

# Create non-root user for development
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nuxtjs --ingroup nodejs

# Copy package files for better layer caching
COPY nuxt-app/package*.json ./
COPY nuxt-app/yarn.lock* ./
COPY nuxt-app/pnpm-lock.yaml* ./

# Change ownership of package files
RUN chown -R nuxtjs:nodejs /app

# Switch to non-root user for dependency installation
USER nuxtjs

# Install dependencies with development optimizations
RUN \
  if [ -f yarn.lock ]; then \
    yarn config set network-timeout 600000 && \
    yarn --frozen-lockfile --silent; \
  elif [ -f package-lock.json ]; then \
    npm ci --silent --no-audit --no-fund; \
  elif [ -f pnpm-lock.yaml ]; then \
    corepack enable pnpm && \
    pnpm i --frozen-lockfile --silent; \
  else \
    echo "❌ Fichier de verrouillage non trouvé." && exit 1; \
  fi

# Development environment variables
ENV NODE_ENV=development
ENV NUXT_HOST=0.0.0.0
ENV NUXT_PORT=3000
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true
ENV NUXT_TELEMETRY_DISABLED=1

# Expose ports for development and HMR
EXPOSE 3000
EXPOSE 24678

# Health check for development
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

# Start development server
CMD ["npm", "run", "dev"]

# Configuration de l'application
NUXT_PUBLIC_APP_NAME="Suivi Santé IA"

# Configuration Supabase
NUXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Configuration Google Vision AI
# Optionnel - si non configuré, l'application utilisera le mode simulation
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
GOOGLE_VISION_PROJECT_ID=your_google_project_id_here

# Configuration Google Generative AI (Gemini)
# Optionnel - si non configuré, le chatbot utilisera le mode simulation
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Exemples :
# NUXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NUXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# GOOGLE_VISION_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# GOOGLE_VISION_PROJECT_ID=my-health-project-123456

# Instructions pour Google Vision AI :
# 1. Créer un projet sur Google Cloud Console
# 2. Activer l'API Vision AI
# 3. Créer une clé API (recommandé pour MVP) ou service account
# 4. Copier la clé dans GOOGLE_VISION_API_KEY
# 5. Redémarrer l'application après modification
